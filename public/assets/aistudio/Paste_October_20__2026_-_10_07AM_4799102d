function recalcAll(){
  let grandItemsTotal = 0; // A + B
  const secTotals = {};

  BOQ.forEach(sec=>{ secTotals[sec.id] = 0; });

  document.querySelectorAll('#sections .section').forEach(secEl=>{
    if(secEl.id === 'sec-ANC') return;
    const secId = secEl.id.replace('sec-','');
    let secTotal = 0;
    secEl.querySelectorAll('.group').forEach(grp=>{
      let gTotal = 0;
      grp.querySelectorAll('.row:not(.note)').forEach(row=>{
        const qtyInp = row.querySelector('.qty');
        const rateInp = row.querySelector('.rate');
        const qty = parseFloat(qtyInp && qtyInp.value) || 0;
        const rate = parseFloat(rateInp && rateInp.value) || 0;
        const amt = qty * rate;
        row.querySelector('.camt').textContent = fmt(amt);
        gTotal += amt;
      });
      grp.querySelector('.g-total').textContent = fmt(gTotal);
      secTotal += gTotal;
    });
    secTotals[secId] = secTotal;
    document.getElementById(`stotal-${secId}`).textContent = fmt(secTotal);
    const navamt = document.getElementById(`navamt-${secId}`);
    if(navamt) navamt.textContent = fmt(secTotal);
    grandItemsTotal += secTotal;
  });

  // Ancillary
  let ancTotal = 0;
  document.querySelectorAll('.anc-row').forEach(r=>{
    const v = parseFloat(r.querySelector('.ancamt').value) || 0;
    ancTotal += v;
  });
  document.getElementById('stotal-ANC').textContent = fmt(ancTotal);
  document.getElementById('anc-group-total').textContent = fmt(ancTotal);
  const navAnc = document.getElementById('navamt-ANC');
  if(navAnc) navAnc.textContent = fmt(ancTotal);

  const subTotal = grandItemsTotal + ancTotal;
  const profitPct = parseFloat(document.getElementById('inProfitPct-d').value) || 0;
  const overheadPct = parseFloat(document.getElementById('inOverheadPct-d').value) || 0;
  const vatPct = parseFloat(document.getElementById('inVatPct-d').value) || 0;

  const profitAmt = subTotal * (profitPct/100);
  const overheadAmt = subTotal * (overheadPct/100);
  const preVat = subTotal + profitAmt + overheadAmt;
  const vatAmt = preVat * (vatPct/100);
  const grandTotal = preVat + vatAmt;

  const cur = currency();
  const set = (id,val)=>{ const el=document.getElementById(id); if(el) el.textContent = val; };

  ['d','m'].forEach(suf=>{
    BOQ.forEach(sec=> set(`sum-sec-${sec.id}-${suf}`, fmt(secTotals[sec.id])));
    set(`sum-anc-${suf}`, fmt(ancTotal));
    set(`sum-subtotal-${suf}`, fmt(subTotal));
    set(`sum-profit-${suf}`, fmt(profitAmt));
    set(`sum-overhead-${suf}`, fmt(overheadAmt));
    set(`sum-prevat-${suf}`, fmt(preVat));
    set(`sum-vat-${suf}`, fmt(vatAmt));
    set(`sum-grand-${suf}`, fmt(grandTotal));
  });
  set('mGrandTotal', fmt(grandTotal));

  document.querySelectorAll('.cur-lbl').forEach(el=> el.textContent = cur);

  return {secTotals, ancTotal, subTotal, profitAmt, overheadAmt, vatAmt, grandTotal};
}

