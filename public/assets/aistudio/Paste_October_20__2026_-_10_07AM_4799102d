<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bill of Quantities — Building Cost Estimator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<style>
  :root{
    --navy:#0F2C4C;
    --navy-2:#173A5E;
    --navy-3:#0A2038;
    --slate:#4C5C6E;
    --slate-light:#7A8A9B;
    --paper:#EEF2F5;
    --card:#FFFFFF;
    --line:#D7E1EA;
    --line-strong:#B9C7D3;
    --amber:#E3A008;
    --amber-dark:#A9740A;
    --green:#2F7D5B;
    --green-bg:#E8F3EE;
    --red:#B3432B;
    --ink:#0F1B24;
    --ink-soft:#455467;
    font-size:16px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;overflow-x:hidden;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height:1.45;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:28px 28px;
    background-attachment:fixed;
  }
  .num{ font-family:'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace; font-variant-numeric:tabular-nums; }

  /* ---------- Top bar ---------- */
  .topbar{
    background:var(--navy-3);
    color:#fff;
    padding:14px 18px;
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    position:sticky;
    top:0;
    z-index:40;
    border-bottom:3px solid var(--amber);
  }
  .topbar .titlewrap{ display:flex; align-items:center; gap:10px; flex:1 1 auto; min-width:0;}
  .topbar .toolbar{ display:flex; gap:8px; flex:none; overflow-x:auto; -webkit-overflow-scrolling:touch; width:100%; }
  @media (min-width:721px){
    .topbar .toolbar{ width:auto; }
  }
  .topbar .mark{
    width:34px;height:34px;border:2px solid var(--amber);
    display:flex;align-items:center;justify-content:center;
    font-family:'IBM Plex Mono';font-weight:600;font-size:13px;color:var(--amber);
    flex:none;
  }
  .topbar h1{
    font-size:15px;
    font-weight:600;
    margin:0;
    letter-spacing:.2px;
    flex:1;
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .topbar .sub{ font-size:11px;color:#A9BCCD;font-weight:400; display:block; margin-top:1px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .topbar button{
    background:transparent;
    border:1px solid #33526e;
    color:#dbe6ee;
    padding:7px 10px;
    font-size:12.5px;
    border-radius:3px;
    cursor:pointer;
    font-family:inherit;
    white-space:nowrap;
    flex:none;
  }
  .topbar button:hover{ border-color:var(--amber); color:var(--amber);}
  @media (max-width:720px){
    .topbar{ padding:12px 14px; }
    .topbar .sub{ display:none; }
  }

  /* ---------- Title block ---------- */
  .titleblock{
    max-width:1180px;
    margin:22px auto 0;
    padding:0 16px;
  }
  .tb-card{
    background:var(--card);
    border:1px solid var(--line-strong);
    border-top:4px solid var(--navy);
    box-shadow:0 1px 2px rgba(15,28,36,.06);
  }
  .tb-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    padding:20px 22px 14px;
    border-bottom:1px solid var(--line);
    gap:16px;
    flex-wrap:wrap;
  }
  .tb-head h2{
    margin:0; font-size:22px; letter-spacing:.3px; color:var(--navy-3); font-weight:700;
  }
  .tb-head p{ margin:4px 0 0; color:var(--ink-soft); font-size:13.5px; max-width:46ch;}
  .tb-sheetno{
    font-family:'IBM Plex Mono'; font-size:12px; color:var(--slate);
    border:1px solid var(--line-strong); padding:6px 10px; text-align:center;
  }
  .tb-sheetno b{ display:block; color:var(--navy); font-size:14px;}
  .tb-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:0;
  }
  .tb-field{
    padding:12px 18px;
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .tb-field:nth-child(3n){ border-right:none; }
  .tb-field label{
    display:block; font-size:10.5px; text-transform:uppercase; letter-spacing:.7px;
    color:var(--slate-light); margin-bottom:5px; font-weight:600;
  }
  .tb-field input{
    width:100%; border:none; background:transparent; font-size:14.5px; color:var(--ink);
    font-family:inherit; padding:2px 0; border-bottom:1px dashed transparent;
  }
  .tb-field input:focus{ outline:none; border-bottom:1px dashed var(--amber-dark); }

  @media (max-width:720px){
    .tb-grid{ grid-template-columns:repeat(2,1fr);}
    .tb-field:nth-child(3n){ border-right:1px solid var(--line);}
    .tb-field:nth-child(2n){ border-right:none;}
    .tb-head{ flex-direction:column; align-items:flex-start;}
  }

  /* ---------- Layout ---------- */
  .layout{
    max-width:1180px; margin:0 auto; padding:18px 16px 120px;
    display:grid; grid-template-columns:230px 1fr; gap:18px;
  }
  .layout > *{ min-width:0; }
  @media (max-width:900px){
    .layout{ grid-template-columns:1fr; }
  }

  /* Section nav */
  .nav{ position:sticky; top:74px; align-self:start; }
  .nav-list{ list-style:none; margin:0; padding:0; background:var(--card); border:1px solid var(--line-strong);}
  .nav-list li a{
    display:flex; justify-content:space-between; gap:8px;
    padding:11px 13px; text-decoration:none; color:var(--ink-soft);
    font-size:13px; font-weight:500; border-bottom:1px solid var(--line);
    cursor:pointer;
  }
  .nav-list li:last-child a{ border-bottom:none;}
  .nav-list li a:hover{ background:#F5F8FA; color:var(--navy);}
  .nav-list li a.active{ background:var(--navy); color:#fff;}
  .nav-list li a .amt{ font-family:'IBM Plex Mono'; font-size:11.5px; color:inherit; opacity:.75;}
  .nav-tools{ margin-top:10px; display:flex; flex-direction:column; gap:6px;}
  .nav-tools button{
    background:var(--card); border:1px solid var(--line-strong); color:var(--slate);
    padding:9px 10px; font-size:12.5px; text-align:left; cursor:pointer; font-family:inherit;
  }
  .nav-tools button:hover{ border-color:var(--navy); color:var(--navy);}

  @media (max-width:900px){
    .nav{ position:static; }
    .nav-list{ display:flex; overflow-x:auto; -webkit-overflow-scrolling:touch;}
    .nav-list li{ flex:none; }
    .nav-list li a{ border-bottom:none; border-right:1px solid var(--line); white-space:nowrap; flex-direction:row;}
    .nav-list li a .amt{ margin-left:6px;}
    .nav-tools{ flex-direction:row; flex-wrap:wrap; }
    .nav-tools button{ flex:1 1 45%; }
  }

  /* Section content */
  .section{ margin-bottom:26px; scroll-margin-top:70px;}
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between; gap:10px;
    padding:10px 2px; border-bottom:2px solid var(--navy); margin-bottom:10px;
  }
  .section-head h3{ margin:0; font-size:17px; color:var(--navy-3); font-weight:700;}
  .section-head .stotal{ font-family:'IBM Plex Mono'; font-size:14px; color:var(--navy); font-weight:600;}

  .group{ background:var(--card); border:1px solid var(--line-strong); margin-bottom:10px;}
  .group-head{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    padding:11px 14px; cursor:pointer; user-select:none;
    border-left:4px solid var(--slate-light);
  }
  .group-head:hover{ border-left-color:var(--amber);}
  .group-head h4{ margin:0; font-size:13.5px; font-weight:600; color:var(--ink);}
  .group-head .g-right{ display:flex; align-items:center; gap:12px; flex:none;}
  .group-head .g-total{ font-family:'IBM Plex Mono'; font-size:13px; color:var(--slate);}
  .group-head .chev{ width:9px;height:9px;border-right:2px solid var(--slate-light);border-bottom:2px solid var(--slate-light); transform:rotate(45deg); transition:transform .15s;}
  .group.open .chev{ transform:rotate(-135deg);}
  .group-body{ display:none; border-top:1px solid var(--line);}
  .group.open .group-body{ display:block; }

  .row{
    display:grid;
    grid-template-columns:52px 1fr 60px 90px 110px 32px 120px;
    gap:8px;
    padding:10px 14px;
    border-bottom:1px solid var(--line);
    align-items:center;
  }
  .row:last-child{ border-bottom:none;}
  .row.note{
    grid-template-columns:1fr;
    background:#FBFCFD;
    color:var(--ink-soft);
    font-size:12.5px;
    font-style:italic;
    padding:8px 14px 8px 30px;
  }
  .row .cno{ font-family:'IBM Plex Mono'; font-size:12px; color:var(--slate-light);}
  .row .cdesc{ font-size:13.3px; color:var(--ink); }
  .row .cunit{ font-size:11.5px; color:var(--slate); background:#EEF2F5; padding:3px 6px; text-align:center; border:1px solid var(--line);}
  .row input[type=number]{
    width:100%; padding:7px 8px; border:1px solid var(--line-strong); font-family:'IBM Plex Mono'; font-size:13px;
    background:#fff; color:var(--ink); text-align:right;
  }
  .row input[type=number]:focus{ outline:none; border-color:var(--amber-dark); box-shadow:0 0 0 2px rgba(227,160,8,.15);}
  .row input[type=number].linked{ background:var(--green-bg); border-color:var(--green); color:var(--green); font-weight:600;}
  .row .camt{ font-family:'IBM Plex Mono'; font-size:13.5px; text-align:right; font-weight:600; color:var(--navy-3);}
  .row.custom{ background:#FFFBF0; }
  .row .cdesc input.customdesc{
    width:100%; border:1px solid var(--line-strong); padding:6px 8px; font-size:13px; font-family:inherit;
  }
  .row .cunit input.customunit{
    width:100%; border:1px solid var(--line-strong); padding:6px 4px; font-size:11.5px; text-align:center; font-family:inherit;
  }
  .row .rmbtn{
    background:none;border:none;color:var(--red);cursor:pointer;font-size:16px;line-height:1;padding:0 2px;
  }
  .tobtn{
    width:30px; height:30px; border:1px solid var(--line-strong); background:#fff; color:var(--slate);
    cursor:pointer; font-size:14px; line-height:1; border-radius:2px; flex:none;
  }
  .tobtn:hover{ border-color:var(--amber-dark); color:var(--amber-dark);}
  .tobtn.active{ background:var(--navy); border-color:var(--navy); color:#fff;}

  /* ---------- Take-off panel (measurement build-up) ---------- */
  .takeoff-panel{
    display:none;
    background:#FCF8EC;
    border-top:1px dashed var(--line-strong);
    border-bottom:1px solid var(--line);
    padding:10px 14px 12px 60px;
  }
  .takeoff-panel.open{ display:block; }
  .to-head{ font-size:11.5px; color:var(--amber-dark); font-weight:600; text-transform:uppercase; letter-spacing:.4px; margin-bottom:8px;}
  .to-line{
    display:flex; align-items:center; gap:6px; margin-bottom:6px; flex-wrap:wrap;
  }
  .to-note{
    flex:1 1 140px; min-width:0; border:1px solid var(--line-strong); padding:6px 8px; font-size:12px; font-family:inherit;
  }
  .to-dims{ display:flex; gap:5px; flex:none; }
  .to-dims input{
    width:64px; border:1px solid var(--line-strong); padding:6px 5px; font-family:'IBM Plex Mono'; font-size:12px; text-align:right;
  }
  .to-lineresult{ font-family:'IBM Plex Mono'; font-size:12.5px; font-weight:600; color:var(--navy); width:74px; text-align:right; flex:none;}
  .bar-kgm-badge{
    font-family:'IBM Plex Mono'; font-size:11px; color:var(--slate); background:#EEF2F5;
    padding:6px 8px; border:1px solid var(--line); white-space:nowrap; flex:none;
  }
  .bar-kgm{
    width:70px; border:1px solid var(--line-strong); padding:6px 5px; font-family:'IBM Plex Mono'; font-size:12px; text-align:right; flex:none;
  }
  .to-rmline{ background:none;border:none;color:var(--red);cursor:pointer;font-size:14px;flex:none;}
  .to-addline{
    background:none; border:1px dashed var(--line-strong); color:var(--slate);
    padding:5px 9px; font-size:11.5px; cursor:pointer; font-family:inherit; margin-top:2px;
  }
  .to-addline:hover{ border-color:var(--amber-dark); color:var(--amber-dark);}
  .to-total-row{
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;
    margin-top:8px; padding-top:8px; border-top:1px solid #EBD9A8; font-size:12px; color:var(--ink-soft);
  }
  .to-total{ color:var(--green); }
  .to-clear{ background:none; border:none; color:var(--slate-light); text-decoration:underline; font-size:11.5px; cursor:pointer; font-family:inherit;}
  .to-clear:hover{ color:var(--red); }

  .group-foot{ display:flex; justify-content:flex-end; align-items:center; gap:10px; padding:8px 14px; background:#F7F9FA;}
  .addrow-btn{
    background:none; border:1px dashed var(--line-strong); color:var(--slate);
    padding:6px 10px; font-size:12px; cursor:pointer; font-family:inherit; margin:8px 14px 12px;
  }
  .addrow-btn:hover{ border-color:var(--amber-dark); color:var(--amber-dark);}

  @media (max-width:640px){
    .row{ grid-template-columns:1fr; gap:4px; padding:12px 14px;}
    .row.note{ padding:8px 14px;}
    .row .cno{ display:inline-block; margin-right:6px;}
    .row .cdesc{ margin-bottom:6px;}
    .row .inline-mobile{ display:flex; gap:8px; align-items:center;}
    .row .cunit{ flex:none; }
    .row input[type=number]{ text-align:left;}
    .row .camt{ text-align:left; margin-top:2px; padding-top:4px; border-top:1px dashed var(--line);}
    .takeoff-panel{ padding:10px 14px 12px; }
    .to-line{ flex-direction:column; align-items:stretch; border-bottom:1px dashed #EBD9A8; padding-bottom:8px;}
    .to-note{ flex:none; width:100%; }
    .to-dims{ flex:none; width:100%; }
    .to-dims input{ flex:1 1 0; width:0; min-width:0; }
    .bar-kgm-badge, .bar-kgm{ width:100%; text-align:left; }
    .to-line .to-lineresult{ width:auto; text-align:left; }
  }

  /* Ancillary section */
  .anc-row{
    display:grid; grid-template-columns:1fr 140px 34px; gap:8px; align-items:center;
    padding:10px 14px; border-bottom:1px solid var(--line);
  }
  .anc-row input{ min-width:0; }
  .anc-row input[type=text]{ border:1px solid var(--line-strong); padding:7px 8px; font-family:inherit; font-size:13px;}
  .anc-row input[type=number]{ border:1px solid var(--line-strong); padding:7px 8px; font-family:'IBM Plex Mono'; text-align:right; font-size:13px;}
  @media (max-width:560px){
    .anc-row{ grid-template-columns:1fr; }
  }

  /* ---------- Summary ---------- */
  .summary-desktop{
    background:var(--card); border:1px solid var(--line-strong); border-top:4px solid var(--amber);
    position:sticky; top:74px; margin-top:14px;
  }
  .summary-desktop h4{ margin:0; padding:12px 14px; font-size:13px; letter-spacing:.4px; text-transform:uppercase; color:var(--navy-3); border-bottom:1px solid var(--line); font-weight:700;}
  .sline{ display:flex; justify-content:space-between; gap:8px; padding:9px 14px; border-bottom:1px solid var(--line); font-size:12.8px; color:var(--ink-soft); align-items:center;}
  .sline b{ font-family:'IBM Plex Mono'; color:var(--ink); font-weight:600; font-size:12.8px;}
  .sline.pct-row input{ width:46px; border:1px solid var(--line-strong); font-family:'IBM Plex Mono'; text-align:right; padding:3px 4px; font-size:12px;}
  .sline.grand{ background:var(--navy-3); color:#fff; padding:14px; }
  .sline.grand span{ font-size:12.5px; text-transform:uppercase; letter-spacing:.4px; color:#BFD2E0;}
  .sline.grand b{ color:var(--amber); font-size:18px; display:block; margin-top:2px;}

  @media (max-width:900px){
    .summary-desktop{ display:none; }
  }

  /* Mobile summary bar */
  .mobile-bar{
    display:none;
    position:fixed; left:0; right:0; bottom:0; z-index:50;
    background:var(--navy-3); color:#fff; border-top:3px solid var(--amber);
  }
  .mobile-bar .mb-head{
    display:flex; justify-content:space-between; align-items:center; padding:11px 16px; cursor:pointer;
  }
  .mobile-bar .mb-head .lbl{ font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:#9FB6C8;}
  .mobile-bar .mb-head .val{ font-family:'IBM Plex Mono'; font-size:17px; color:var(--amber); font-weight:600;}
  .mobile-bar .mb-head .arrow{ width:8px;height:8px;border-right:2px solid #9FB6C8;border-top:2px solid #9FB6C8; transform:rotate(-45deg); transition:transform .15s;}
  .mobile-bar.open .mb-head .arrow{ transform:rotate(135deg);}
  .mobile-bar .mb-body{ display:none; padding:0 16px 14px; max-height:55vh; overflow-y:auto;}
  .mobile-bar.open .mb-body{ display:block;}
  .mobile-bar .sline{ border-bottom:1px solid #1F3F5C; color:#C7D6E2; padding:8px 0;}
  .mobile-bar .sline b{ color:#fff;}
  .mobile-bar .sline.pct-row input{ background:#0F2740; border-color:#2A4A66; color:#fff;}

  @media (max-width:900px){
    .mobile-bar{ display:block; }
  }

  /* Print */
  @media print{
    .topbar, .mobile-bar, .addrow-btn, .rmbtn, .group-foot, .nav-list, .nav-tools, .tobtn, .to-addline, .to-clear, .to-rmline{ display:none !important;}
    body{ background:#fff; }
    .layout{ display:block; padding:0;}
    .nav{ position:static; width:100%; margin-bottom:16px; }
    .group-body{ display:block !important;}
    .group{ break-inside:avoid;}
    .section-head{ break-after:avoid; break-inside:avoid; }
    .section + .section{ break-before: page; page-break-before: always; }
    input{ border:none !important; background:transparent !important; -moz-appearance:textfield; }
    input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }
    .summary-desktop{ display:block !important; position:static; max-width:420px; }
    .takeoff-panel{ display:none; }
    .takeoff-panel:has(.to-line){ display:block !important; break-inside:avoid; }
  }

  .foot-note{ max-width:1180px; margin:10px auto 40px; padding:0 16px; font-size:11.5px; color:var(--slate-light); text-align:center;}
</style>
</head>
<body>

<div class="topbar">
  <div class="titlewrap">
    <div class="mark">BQ</div>
    <div style="min-width:0;">
      <h1>Bill of Quantities — Universal Building Cost Estimator</h1>
      <span class="sub">Fill in quantities &amp; rates for your own project</span>
    </div>
  </div>
  <div class="toolbar">
    <button id="btnExpandAll">Expand all</button>
    <button id="btnPrint">Print / PDF</button>
    <button id="btnExcel">Export Excel</button>
    <button id="btnReset">Reset</button>
  </div>
</div>

<div class="titleblock">
  <div class="tb-card">
    <div class="tb-head">
      <div>
        <h2>Bill of Quantities</h2>
        <p>A standardised item list covering substructure, superstructure, finishes and services — enter your own quantities and unit rates below to generate a full cost estimate for any building.</p>
      </div>
      <div class="tb-sheetno">Sheet No.<b id="sheetDate">—</b></div>
    </div>
    <div class="tb-grid">
      <div class="tb-field"><label>Project</label><input id="fProject" type="text" placeholder="e.g. G+2 Residential Building" value="G+2 Micro Cluster Building"></div>
      <div class="tb-field"><label>Location</label><input id="fLocation" type="text" placeholder="Town / Region" value=""></div>
      <div class="tb-field"><label>Client</label><input id="fClient" type="text" placeholder="Client name" value=""></div>
      <div class="tb-field"><label>Contractor</label><input id="fContractor" type="text" placeholder="Contractor name" value=""></div>
      <div class="tb-field"><label>Consultant</label><input id="fConsultant" type="text" placeholder="Consultant / Engineer" value=""></div>
      <div class="tb-field"><label>Currency</label><input id="fCurrency" type="text" placeholder="e.g. ETB, USD" value="ETB"></div>
    </div>
  </div>
</div>

<div class="layout">

  <div class="nav">
    <ul class="nav-list" id="navList"></ul>
    <div class="nav-tools">
      <button id="btnExpandAll2">Expand all sections</button>
      <button id="btnCollapseAll">Collapse all</button>
    </div>
  </div>

  <div id="sections"></div>

</div>

<div class="foot-note">All quantities and rates default to zero — this is a blank estimating template. Item descriptions follow a standard building specification and apply to most residential and institutional building types; add custom items where a project needs something outside the standard list. Click the 📐 icon next to any Qty field to build that quantity from measured dimensions, or the Ø icon on reinforcement items to build the weight from a bar schedule (length × no. of bars × no. of members × unit weight) — the way traditional take-off and bar-schedule sheets work.</div>

<!-- Desktop summary lives inside layout via JS injection target -->
<div style="display:none" id="summaryTemplateHolder"></div>

<div class="mobile-bar" id="mobileBar">
  <div class="mb-head" id="mobileBarHead">
    <div><span class="lbl">Grand Total</span></div>
    <div style="display:flex; align-items:center; gap:10px;">
      <span class="val num" id="mGrandTotal">0.00</span>
      <span class="arrow"></span>
    </div>
  </div>
  <div class="mb-body" id="mobileBarBody"></div>
</div>

<script>
