function gatherReportModel(){
  const model = { sections: [], ancillary: [] };
  document.querySelectorAll('#sections .section').forEach(secEl=>{
    if(secEl.id === 'sec-ANC') return;
    const secTitle = secEl.querySelector('.section-head h3').textContent;
    const secTotal = parseFloat(secEl.querySelector('.stotal').textContent.replace(/,/g,'')) || 0;
    const groups = [];
    secEl.querySelectorAll('.group').forEach(grp=>{
      const gTitle = grp.querySelector('h4').textContent;
      const gTotal = parseFloat(grp.querySelector('.g-total').textContent.replace(/,/g,'')) || 0;
      const rows = [];
      grp.querySelectorAll('.row').forEach(row=>{
        if(row.classList.contains('note')){
          rows.push({type:'note', text: row.textContent.trim()});
          return;
        }
        const isCustom = row.classList.contains('custom');
        const no = isCustom ? '' : row.querySelector('.cno').textContent;
        const desc = isCustom ? row.querySelector('.customdesc').value : row.querySelector('.cdesc').textContent;
        const unit = isCustom ? row.querySelector('.customunit').value : row.querySelector('.cunit').textContent;
        const qty = parseFloat(row.querySelector('.qty').value) || 0;
        const rate = parseFloat(row.querySelector('.rate').value) || 0;
        rows.push({type:'item', no, desc, unit, qty, rate, amt: qty*rate});
      });
      groups.push({title:gTitle, total:gTotal, rows});
    });
    model.sections.push({title:secTitle, total:secTotal, groups});
  });
  document.querySelectorAll('.anc-row').forEach(r=>{
    model.ancillary.push({
      desc: r.querySelector('.ancdesc').value || 'Ancillary item',
      amt: parseFloat(r.querySelector('.ancamt').value) || 0
    });
  });
  return model;
}

async function exportExcel(){
  const btn = document.getElementById('btnExcel');
  if(typeof ExcelJS === 'undefined'){
    alert('The Excel export engine could not load (needs an internet connection the first time). Try again when online, or use Print / PDF instead.');
    return;
  }
  const originalLabel = btn.textContent;
  btn.textContent = 'Building…'; btn.disabled = true;
  try{
    const cur = currency();
    const model = gatherReportModel();
    const vals = recalcAll();
    const ancTotal = model.ancillary.reduce((a,b)=> a+b.amt, 0);

    const NAVY='FF0F2C4C', NAVY2='FF17385A', GROUPFILL='FFE7ECEF', NOTEFILL='FFFBFCFD',
          ZEBRA='FFF6F8FA', AMBER='FFE3A008', BORDER='FFD7E1EA', WHITE='FFFFFFFF', INK='FF101820', SOFT='FF5B6B7C';

    const wb = new ExcelJS.Workbook();
    wb.creator = 'Bill of Quantities Calculator';
    wb.created = new Date();
    const ws = wb.addWorksheet('Bill of Quantities', {
      pageSetup: { fitToWidth:1, fitToHeight:0, orientation:'portrait', margins:{left:0.4,right:0.4,top:0.5,bottom:0.5,header:0.2,footer:0.2} },
      views: [{ showGridLines:false }]
    });
    ws.columns = [
      { key:'no', width:9 }, { key:'desc', width:62 }, { key:'unit', width:8 },
      { key:'qty', width:12 }, { key:'rate', width:13 }, { key:'amt', width:16 },
    ];

    const thinBorder = { bottom:{style:'thin', color:{argb:BORDER}} };
    function paint(rowIdx, {bold, italic, size, color, fill, align, border}={}){
      const row = ws.getRow(rowIdx);
      row.eachCell({includeEmpty:true}, cell=>{
        cell.font = { name:'Calibri', size: size||10.5, bold: !!bold, italic: !!italic, color:{argb: color||INK} };
        cell.alignment = Object.assign({ vertical:'middle', wrapText:true }, align||{});
        if(fill) cell.fill = { type:'pattern', pattern:'solid', fgColor:{argb:fill} };
        cell.border = border===false ? {} : thinBorder;
      });
    }
    function money(cell, value){ cell.value = value; cell.numFmt = '#,##0.00'; cell.alignment = {horizontal:'right', vertical:'middle'}; }

    let r = 1;
    ws.mergeCells(`A${r}:F${r}`);
    ws.getCell(`A${r}`).value = 'BILL OF QUANTITIES';
    paint(r, {bold:true, size:16, color:WHITE, fill:NAVY});
    ws.getRow(r).height = 26; r++;

    ws.mergeCells(`A${r}:F${r}`);
    ws.getCell(`A${r}`).value = `Universal building cost estimate — generated ${new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}`;
    paint(r, {italic:true, size:9, color:SOFT, border:false}); r += 2;

    const fields = [
      ['Project', val('fProject')], ['Location', val('fLocation')], ['Client', val('fClient')],
      ['Contractor', val('fContractor')], ['Consultant', val('fConsultant')], ['Currency', cur],
    ];
    fields.forEach(([label, value])=>{
      ws.mergeCells(`A${r}:B${r}`);
      const lc = ws.getCell(`A${r}`); lc.value = label;
      lc.font = { bold:true, size:9, color:{argb:SOFT} }; lc.border = thinBorder;
      ws.mergeCells(`C${r}:F${r}`);
      const vc = ws.getCell(`C${r}`); vc.value = value || '—';
      vc.font = { size:10.5, color:{argb:INK} }; vc.border = thinBorder;
      r++;
    });
    r++;

    ws.mergeCells(`A${r}:F${r}`);
    ws.getCell(`A${r}`).value = 'COST SUMMARY';
    paint(r, {bold:true, size:11, color:WHITE, fill:NAVY2}); r++;

    const summaryLines = [
      [model.sections[0] ? model.sections[0].title : 'A — Sub-Structure', model.sections[0] ? model.sections[0].total : 0],
      [model.sections[1] ? model.sections[1].title : 'B — Super-Structure', model.sections[1] ? model.sections[1].total : 0],
      ['Ancillary structures', ancTotal],
      ['Sub-total', vals.subTotal],
      [`Profit (${val('inProfitPct-d')}%)`, vals.profitAmt],
      [`Overhead (${val('inOverheadPct-d')}%)`, vals.overheadAmt],
      ['Total before VAT', vals.subTotal + vals.profitAmt + vals.overheadAmt],
      [`VAT (${val('inVatPct-d')}%)`, vals.vatAmt],
    ];
    summaryLines.forEach(([label, amt])=>{
      ws.mergeCells(`A${r}:D${r}`);
      ws.getCell(`A${r}`).value = label;
      ws.getCell(`A${r}`).font = { size:10.5, color:{argb:INK} };
      ws.getCell(`A${r}`).border = thinBorder;
      ws.mergeCells(`E${r}:F${r}`);
      money(ws.getCell(`E${r}`), amt);
      ws.getCell(`E${r}`).border = thinBorder;
      r++;
    });
    ws.mergeCells(`A${r}:D${r}`);
    ws.getCell(`A${r}`).value = `GRAND TOTAL (${cur})`;
    ws.mergeCells(`E${r}:F${r}`);
    money(ws.getCell(`E${r}`), vals.grandTotal);
    ws.getCell(`E${r}`).font = { bold:true, size:13, color:{argb:AMBER} };
    paint(r, {bold:true, size:13, color:WHITE, fill:NAVY});
    ws.getCell(`E${r}`).fill = { type:'pattern', pattern:'solid', fgColor:{argb:NAVY} };
    ws.getRow(r).height = 22; r += 2;

    ws.getRow(r).values = ['Item No','Description','Unit','Qty','Rate',`Amount (${cur})`];
    paint(r, {bold:true, color:WHITE, fill:NAVY});
    ws.views = [{ showGridLines:false, state:'frozen', ySplit:r }];
    r++;

    model.sections.forEach(sec=>{
      ws.mergeCells(`A${r}:E${r}`);
      ws.getCell(`A${r}`).value = sec.title;
      money(ws.getCell(`F${r}`), sec.total);
      ws.getCell(`F${r}`).font = { bold:true, size:11.5, color:{argb:WHITE} };
      paint(r, {bold:true, size:11.5, color:WHITE, fill:NAVY2}); r++;

      sec.groups.forEach(g=>{
        ws.mergeCells(`A${r}:E${r}`);
        ws.getCell(`A${r}`).value = '   ' + g.title;
        money(ws.getCell(`F${r}`), g.total);
        ws.getCell(`F${r}`).font = { bold:true, size:10.5, color:{argb:INK} };
        paint(r, {bold:true, fill:GROUPFILL}); r++;

        let zebra = false;
        g.rows.forEach(row=>{
          if(row.type === 'note'){
            ws.mergeCells(`A${r}:F${r}`);
            ws.getCell(`A${r}`).value = '   ' + row.text;
            paint(r, {italic:true, size:9.5, color:SOFT, fill:NOTEFILL});
          } else {
            ws.getRow(r).values = [row.no, row.desc, row.unit, row.qty, row.rate, row.amt];
            paint(r, { fill: zebra ? ZEBRA : undefined });
            ws.getCell(`C${r}`).alignment = { horizontal:'center', vertical:'middle' };
            ws.getCell(`D${r}`).numFmt = '#,##0.00'; ws.getCell(`D${r}`).alignment = {horizontal:'right', vertical:'middle'};
            ws.getCell(`E${r}`).numFmt = '#,##0.00'; ws.getCell(`E${r}`).alignment = {horizontal:'right', vertical:'middle'};
            ws.getCell(`F${r}`).numFmt = '#,##0.00'; ws.getCell(`F${r}`).alignment = {horizontal:'right', vertical:'middle'};
            ws.getCell(`F${r}`).font = { bold:true, size:10.5, color:{argb:NAVY} };
            zebra = !zebra;
          }
          r++;
        });
      });
    });

    ws.mergeCells(`A${r}:E${r}`);
    ws.getCell(`A${r}`).value = 'C — Ancillary Structures';
    money(ws.getCell(`F${r}`), ancTotal);
    ws.getCell(`F${r}`).font = { bold:true, size:11.5, color:{argb:WHITE} };
    paint(r, {bold:true, size:11.5, color:WHITE, fill:NAVY2}); r++;
    model.ancillary.forEach(a=>{
      ws.mergeCells(`A${r}:E${r}`);
      ws.getCell(`A${r}`).value = a.desc;
      money(ws.getCell(`F${r}`), a.amt);
      ws.getCell(`F${r}`).font = { size:10.5, color:{argb:NAVY} };
      paint(r); r++;
    });

    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const projectName = (val('fProject') || 'BOQ').replace(/[^a-z0-9]+/gi,'_');
    a.href = url; a.download = `${projectName}_BOQ.xlsx`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  } catch(err){
    console.error(err);
    alert('Something went wrong building the Excel file. Please try again.');
  } finally {
    btn.textContent = originalLabel; btn.disabled = false;
  }
}

/* Scroll-spy for nav */
function wireScrollSpy(){
  const links = Array.from(document.querySelectorAll('#navList a'));
  const targets = links.map(l=> document.getElementById(l.dataset.target)).filter(Boolean);
  window.addEventListener('scroll', ()=>{
    let current = targets[0];
    for(const t of targets){ if(t.getBoundingClientRect().top - 90 <= 0) current = t; }
    links.forEach(l=> l.classList.toggle('active', current && l.dataset.target === current.id));
  }, {passive:true});
}

/* Init */
document.getElementById('sheetDate').textContent = new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
buildNav();
buildSections();
buildSummaryPanels();
wireGlobalControls();
wireScrollSpy();
recalcAll();
</script>
