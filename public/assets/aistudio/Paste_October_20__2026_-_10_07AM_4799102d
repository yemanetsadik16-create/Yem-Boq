}

/* Take-off dimension configuration per unit — mirrors a traditional
   quantity take-off sheet: No. (count) x Length x Width x Height/Depth */
const DIM_CONFIG = {
  'm³': ['No.','L (m)','W (m)','H (m)'],
  'm²': ['No.','L (m)','W (m)'],
  'ml':  ['No.','L (m)'],
};
function dimsForUnit(u){ return DIM_CONFIG[u] || ['No.']; }

/* Detect a rebar diameter mentioned in an item's own description, e.g.
   "8mm diameter deformed bars" -> 8. Used to auto-fill the standard
   unit weight (kg/m = d²/162) in the bar schedule, exactly as a
   reinforcement bar-schedule sheet does. */
function detectDiameter(text){
  const m = text.match(/(\d+(?:\.\d+)?)\s*mm\s*diameter/i);
  return m ? parseFloat(m[1]) : null;
}
function barUnitWeight(dia){ return (dia*dia)/162; }
function panelTypeForUnit(u){ return u === 'kg' ? 'bar' : 'dims'; }

function rowTemplate(row, gi, ri){
  if(row.n){
    return `<div class="row note">${row.t}</div>`;
  }
  const key = `${gi}-${ri}`;
  const type = panelTypeForUnit(row.u);
  const dia = type === 'bar' ? detectDiameter(row.t) : null;

  let headText, totalLabel;
  if(type === 'bar'){
    headText = dia
      ? `Bar schedule — Ø${dia}mm deformed bar (standard unit weight ${barUnitWeight(dia).toFixed(3)} kg/m) × length × no. of bars × no. of members`
      : `Section weight schedule — enter the unit weight (kg/m) for this steel section, then length × no. of pieces × no. of members`;
    totalLabel = 'Total weight';
  } else {
    headText = `Take-off — build this quantity from measurements (${row.u})`;
    totalLabel = 'Take-off total';
  }

  return `
    <div class="row" data-gi="${gi}" data-ri="${ri}" data-key="${key}">
      <div class="cno">${row.no}</div>
      <div class="cdesc">${row.t}</div>
      <div class="inline-mobile">
        <div class="cunit">${row.u}</div>
        <input type="number" min="0" step="any" class="qty" placeholder="Qty" value="">
      </div>
      <div class="inline-mobile">
        <input type="number" min="0" step="any" class="rate" placeholder="Rate" value="">
        <button class="tobtn" data-row="${key}" title="${type==='bar' ? 'Build weight from a bar schedule' : 'Build quantity from measurements (take-off)'}">${type==='bar' ? 'Ø' : '📐'}</button>
      </div>
      <div class="camt num">0.00</div>
    </div>
    <div class="takeoff-panel" id="to-${key}" data-unit="${row.u}" data-type="${type}" data-dia="${dia||''}">
      <div class="to-head">${headText}</div>
      <div class="to-lines"></div>
      <button class="to-addline" data-row="${key}">+ Add line</button>
      <div class="to-total-row">
        <span>${totalLabel}: <b class="to-total num">0.00</b> ${row.u} → used as Qty</span>
        <button class="to-clear" data-row="${key}">Clear &amp; enter Qty manually</button>
      </div>
    </div>`;
}

function buildSections(){
  const wrap = document.getElementById('sections');
  wrap.innerHTML = '';
  BOQ.forEach(sec=>{
    const secEl = document.createElement('div');
    secEl.className = 'section';
    secEl.id = `sec-${sec.id}`;
    let groupsHtml = '';
    sec.groups.forEach((g, gi)=>{
      let rowsHtml = '';
      g.rows.forEach((row, ri)=>{ rowsHtml += rowTemplate(row, `${sec.id}-${gi}`, ri); });
      groupsHtml += `
        <div class="group" data-secid="${sec.id}" data-gid="${sec.id}-${gi}">
          <div class="group-head">
            <h4>${g.title}</h4>
            <div class="g-right"><span class="g-total num">0.00</span><span class="chev"></span></div>
          </div>
          <div class="group-body">
            <div class="rowset">${rowsHtml}</div>
            <button class="addrow-btn" data-add="${sec.id}-${gi}">+ Add custom item to this group</button>
          </div>
        </div>`;
    });
    secEl.innerHTML = `
      <div class="section-head"><h3>${sec.title}</h3><span class="stotal num" id="stotal-${sec.id}">0.00</span></div>
      ${groupsHtml}`;
    wrap.appendChild(secEl);
  });

  // Ancillary section
  const ancEl = document.createElement('div');
  ancEl.className = 'section';
  ancEl.id = 'sec-ANC';
  ancEl.innerHTML = `
    <div class="section-head"><h3>C — Ancillary Structures</h3><span class="stotal num" id="stotal-ANC">0.00</span></div>
    <div class="group open" data-secid="ANC">
      <div class="group-head" style="cursor:default;">
        <h4>Site &amp; ancillary works (lump sum items — e.g. septic tank, fence, guard house)</h4>
        <div class="g-right"><span class="g-total num" id="anc-group-total">0.00</span></div>
      </div>
      <div class="group-body" style="display:block;">
        <div id="ancRows"></div>
        <button class="addrow-btn" id="addAncRow">+ Add ancillary item</button>
      </div>
    </div>`;
  wrap.appendChild(ancEl);

  ANCILLARY_DEFAULTS.forEach(a=> addAncillaryRow(a.desc, a.amt));

  wrap.querySelectorAll('.group-head').forEach(h=>{
    h.addEventListener('click', (e)=>{
      const grp = h.closest('.group');
      if(grp.dataset.secid === 'ANC') return;
      grp.classList.toggle('open');
    });
  });
  wrap.querySelectorAll('input.qty, input.rate').forEach(inp=> inp.addEventListener('input', recalcAll));
  wrap.querySelectorAll('.addrow-btn[data-add]').forEach(btn=>{
    btn.addEventListener('click', ()=> addCustomRow(btn.dataset.add, btn));
  });
  document.getElementById('addAncRow').addEventListener('click', ()=> addAncillaryRow('', 0));

  wireTakeoffDelegation(wrap);
}

/* =======================================================================
   TAKE-OFF & BAR SCHEDULE (quantity build-up) — mirrors the source
   file's take-off sheet (No. x L x W x H lines) and bar schedule sheet
   (Length x No. of bars x No. of members x unit weight), each summed
   into a single quantity that feeds the BOQ.
   ======================================================================= */
function takeoffLineHtml(dims){
  const fields = dims.map(d=> `<input type="number" step="any" class="to-dim" placeholder="${d}">`).join('');
  return `<div class="to-line">
      <input type="text" class="to-note" placeholder="Note (e.g. location / element)">
      <div class="to-dims">${fields}</div>
      <span class="to-lineresult num">0.00</span>
      <button class="to-rmline" title="Remove line">✕</button>
    </div>`;
}

function barLineHtml(dia){
  const kgmField = dia
    ? `<span class="bar-kgm-badge num" title="Standard deformed-bar unit weight = diameter² ÷ 162">Ø${dia}mm · ${barUnitWeight(dia).toFixed(3)} kg/m</span>`
    : `<input type="number" step="any" class="bar-kgm" placeholder="kg/m">`;
  return `<div class="to-line bar-line" data-dia="${dia||''}">
      <input type="text" class="to-note" placeholder="Note (e.g. location / member)">
      <div class="to-dims">
        <input type="number" step="any" class="bar-len" placeholder="L (m)">
        <input type="number" step="any" class="bar-nbar" placeholder="No. bars">
        <input type="number" step="any" class="bar-nmember" placeholder="No. members">
      </div>
      ${kgmField}
      <span class="to-lineresult num">0.00</span>
      <button class="to-rmline" title="Remove line">✕</button>
    </div>`;
}

function lineHtmlForPanel(panel){
  if(panel.dataset.type === 'bar'){
    const dia = parseFloat(panel.dataset.dia) || null;
    return barLineHtml(dia);
  }
  return takeoffLineHtml(dimsForUnit(panel.dataset.unit));
}

function lineProduct(dimInputs){
  const raw = dimInputs.map(i=> i.value.trim());
  if(raw.every(v=> v==='')) return 0;
  return raw.reduce((acc,v)=>{
    const n = parseFloat(v);
    return acc * (isNaN(n) ? 1 : n);
  }, 1);
}

function finalizeTakeoffTotal(panel, total){
  panel.querySelector('.to-total').textContent = fmt(total);
  const key = panel.id.replace('to-','');
  const row = document.querySelector(`.row[data-key="${key}"]`);
  if(row){
    const qtyInput = row.querySelector('.qty');
    const hasLines = panel.querySelectorAll('.to-line').length > 0;
    if(hasLines){
      qtyInput.value = total;
      qtyInput.readOnly = true;
      qtyInput.classList.add('linked');
    } else {
      qtyInput.readOnly = false;
      qtyInput.classList.remove('linked');
    }
  }
  recalcAll();
}

function recomputeTakeoff(panel){
  let total = 0;
  if(panel.dataset.type === 'bar'){
    panel.querySelectorAll('.to-line').forEach(line=>{
      const dims = [line.querySelector('.bar-len'), line.querySelector('.bar-nbar'), line.querySelector('.bar-nmember')];
      const totalLen = lineProduct(dims);
      const dia = parseFloat(line.dataset.dia) || null;
      const kgm = dia ? barUnitWeight(dia) : (parseFloat((line.querySelector('.bar-kgm')||{}).value) || 0);
      const weight = totalLen * kgm;
      line.querySelector('.to-lineresult').textContent = fmt(weight);
      total += weight;
    });
  } else {
    panel.querySelectorAll('.to-line').forEach(line=>{
      const dimInputs = Array.from(line.querySelectorAll('.to-dim'));
      const p = lineProduct(dimInputs);
      line.querySelector('.to-lineresult').textContent = fmt(p);
      total += p;
    });
  }
  finalizeTakeoffTotal(panel, total);
}

function wireTakeoffDelegation(wrap){
  wrap.addEventListener('click', (e)=>{
    const tobtn = e.target.closest('.tobtn');
    if(tobtn){
      const panel = document.getElementById(`to-${tobtn.dataset.row}`);
      const opening = !panel.classList.contains('open');
      panel.classList.toggle('open');
      tobtn.classList.toggle('active', opening);
      if(opening && panel.querySelectorAll('.to-line').length === 0){
        panel.querySelector('.to-lines').insertAdjacentHTML('beforeend', lineHtmlForPanel(panel));
      }
      return;
    }
    const addBtn = e.target.closest('.to-addline');
    if(addBtn){
      const panel = document.getElementById(`to-${addBtn.dataset.row}`);
      panel.querySelector('.to-lines').insertAdjacentHTML('beforeend', lineHtmlForPanel(panel));
      return;
    }
    const rmBtn = e.target.closest('.to-rmline');
    if(rmBtn){
      const panel = rmBtn.closest('.takeoff-panel');
      rmBtn.closest('.to-line').remove();
      recomputeTakeoff(panel);
      return;
    }
    const clearBtn = e.target.closest('.to-clear');
    if(clearBtn){
      const panel = document.getElementById(`to-${clearBtn.dataset.row}`);
      panel.querySelector('.to-lines').innerHTML = '';
      panel.classList.remove('open');
      const tobtn = wrap.querySelector(`.tobtn[data-row="${clearBtn.dataset.row}"]`);
      if(tobtn) tobtn.classList.remove('active');
      recomputeTakeoff(panel);
      return;
    }
  });
  wrap.addEventListener('input', (e)=>{
    if(e.target.classList.contains('to-dim') || e.target.classList.contains('bar-len') ||
       e.target.classList.contains('bar-nbar') || e.target.classList.contains('bar-nmember') ||
       e.target.classList.contains('bar-kgm')){
      recomputeTakeoff(e.target.closest('.takeoff-panel'));
    }
  });
}

